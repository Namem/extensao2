# Ceres Diagnóstico — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o .env — apenas o .env.example
#
# Como usar:
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=sua-secret-key-django-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# PostgreSQL (porta 5433 — instalado direto no Windows, sem Docker)
# ---------------------------------------------------------------------------
DB_NAME=ceres_db
DB_USER=ceres_user
DB_PASSWORD=sua-senha-aqui
DB_HOST=localhost
DB_PORT=5433

# ---------------------------------------------------------------------------
# MQTT — Mosquitto local
# ---------------------------------------------------------------------------
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=ceres/sensor/#

# ---------------------------------------------------------------------------
# E-mail (SMTP Gmail — reset de senha)
# Gerar App Password: Google Account > Segurança > Senhas de app
# ---------------------------------------------------------------------------
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---------------------------------------------------------------------------
# Edge Impulse (Experimento A — opcional, nao necessario para rodar o backend)
# ---------------------------------------------------------------------------
EDGE_IMPULSE_API_KEY=ei_sua_api_key_aqui
