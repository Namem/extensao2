// config.h.example — copie para config.h e preencha seus valores
// NUNCA commitar config.h (está no .gitignore)

#pragma once

// ── WiFi ──────────────────────────────────────────────────────────────────────
#define WIFI_SSID     "SUA_REDE"
#define WIFI_PASSWORD "SUA_SENHA"

// ── MQTT ──────────────────────────────────────────────────────────────────────
// Para Mosquitto local:
//   #define MQTT_BROKER "192.168.1.100"
//   #define MQTT_PORT   1883
//   (não defina MQTT_TLS, MQTT_USER, MQTT_PASSWORD)
//
// Para HiveMQ Cloud:
//   #define MQTT_TLS
//   #define MQTT_BROKER "ee2c89bab44b4549b717b155ee1d1c48.s1.eu.hivemq.cloud"
//   #define MQTT_PORT   8883
//   #define MQTT_USER     "ceres"
//   #define MQTT_PASSWORD "Ceresadmin1"

#define MQTT_BROKER "192.168.1.100"
#define MQTT_PORT   1883

// ── Dispositivo ───────────────────────────────────────────────────────────────
#define DEVICE_ID    "ceres-esp32-01"
#define MQTT_TOPIC   "ceres/sensor/dados"

// ── Sensores ──────────────────────────────────────────────────────────────────
#define PIN_DHT22   4
#define PIN_SOLO    5

// ── DHT22 retry (checksum errors por interferencia WiFi IRQ) ─────────────────
#define DHT_MAX_RETRIES    3
#define DHT_RETRY_DELAY_MS 500

// ── Intervalo de publicacao (ms) ──────────────────────────────────────────────
#define PUBLISH_INTERVAL_MS 30000
